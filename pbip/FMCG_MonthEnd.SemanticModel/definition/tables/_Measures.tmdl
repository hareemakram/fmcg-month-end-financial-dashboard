			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Active Customers], DATESBETWEEN ( 'Date'[Date], EOMONTH ( _rd, -1 ) + 1, _rd ) )
			    )
		formatString: #,0
		displayFolder: 05 Reporting Period
		lineageTag: f136e861-03e9-5644-9eb4-b6074add586b

	/// [Active Customers] for year-to-date through the reporting month.
	measure 'Active Customers (YTD)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Active Customers], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _rd ), 1, 1 ), _rd ) )
			    )
		formatString: #,0
		displayFolder: 05 Reporting Period
		lineageTag: 463ed294-af86-503d-a812-4679e1a57ec8

	/// [Avg Order Value] for year-to-date through the reporting month.
	measure 'Avg Order Value (YTD)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Avg Order Value], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _rd ), 1, 1 ), _rd ) )
			    )
		formatString: \$#,0
		displayFolder: 05 Reporting Period
		lineageTag: 5928b337-1486-5530-9c4a-423152e2f717

	/// Month-over-month growth of net sales for the reporting month.
	measure 'MoM %' =
			VAR _cur = [Net Sales (Month)]
			VAR _prev = [Net Sales (Prior Month)]
			RETURN
			    IF ( NOT ISBLANK ( _cur ), DIVIDE ( _cur - _prev, _prev ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Reporting Period
		lineageTag: 6daa709e-65e6-5774-adb1-7b621a985e76

	/// Reporting month vs the same month last year.
	measure 'YoY % (Month)' =
			VAR _cur = [Net Sales (Month)]
			VAR _prev = [Net Sales (PY Month)]
			RETURN
			    IF ( NOT ISBLANK ( _cur ), DIVIDE ( _cur - _prev, _prev ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Reporting Period
		lineageTag: 1f76a5b7-b590-534f-a61f-be8d3844e278

	/// Quarter-to-date vs the equivalent period of the prior quarter.
	measure 'QoQ %' =
			VAR _cur = [Net Sales (QTD)]
			VAR _prev = [Net Sales (Prior QTD)]
			RETURN
			    IF ( NOT ISBLANK ( _cur ), DIVIDE ( _cur - _prev, _prev ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Reporting Period
		lineageTag: 613b66b0-716e-5d85-af6d-b9ce85d15bd8

	/// Quarter-to-date vs the same period last year.
	measure 'YoY % (QTD)' =
			VAR _cur = [Net Sales (QTD)]
			VAR _prev = [Net Sales (PY QTD)]
			RETURN
			    IF ( NOT ISBLANK ( _cur ), DIVIDE ( _cur - _prev, _prev ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Reporting Period
		lineageTag: 3f05c96c-fd55-503a-b0e8-1a623c07ab56

	/// Year-to-date vs the same period last year.
	measure 'YoY % (YTD)' =
			VAR _cur = [Net Sales (YTD)]
			VAR _prev = [Net Sales (PY YTD)]
			RETURN
			    IF ( NOT ISBLANK ( _cur ), DIVIDE ( _cur - _prev, _prev ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Reporting Period
		lineageTag: 5157e442-8c3a-5264-973a-57017eb30516

	/// Rolling 12 months vs the prior rolling 12 months.
	measure 'YoY % (R12M)' =
			VAR _cur = [Net Sales (R12M)]
			VAR _prev = [Net Sales (PY R12M)]
			RETURN
			    IF ( NOT ISBLANK ( _cur ), DIVIDE ( _cur - _prev, _prev ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Reporting Period
		lineageTag: 938777d5-debe-59e4-96de-664258bdfb2c

	/// Month-over-month change in net sales ($).
	measure 'MoM Change' = IF ( NOT ISBLANK ( [Net Sales (Month)] ), [Net Sales (Month)] - [Net Sales (Prior Month)] )
		formatString: +\$#,0;-\$#,0;\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: 3259d904-bfbf-529a-b3f6-8413351420d7

	/// Year-to-date change vs last year ($).
	measure 'YoY Change (YTD)' = IF ( NOT ISBLANK ( [Net Sales (YTD)] ), [Net Sales (YTD)] - [Net Sales (PY YTD)] )
		formatString: +\$#,0;-\$#,0;\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: 360f079b-cb1d-5f3d-80c1-41a85854d46c

	/// Change in YTD gross margin % vs last year (percentage points).
	measure 'GM % pts vs PY (YTD)' = IF ( NOT ISBLANK ( [Net Sales (YTD)] ), [Gross Margin % (YTD)] - [Gross Margin % (PY YTD)] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Reporting Period
		lineageTag: 9c0f9206-cfda-57e2-8a5d-ccba99ae7af0

	/// Change in the reporting month's gross margin % vs the same month last year.
	measure 'GM % pts vs PY (Month)' = IF ( NOT ISBLANK ( [Net Sales (Month)] ), [Gross Margin % (Month)] - [Gross Margin % (PY Month)] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Reporting Period
		lineageTag: c20f373e-663b-5655-86e1-908e1a2346e9

	/// Change in YTD discount depth vs last year (percentage points).
	measure 'Discount % pts vs PY (YTD)' = IF ( NOT ISBLANK ( [Net Sales (YTD)] ), [Discount % (YTD)] - [Discount % (PY YTD)] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 05 Reporting Period
		lineageTag: 875808f9-9df0-5a08-83fd-c8fca0e86ca1

	/// Net sales for the same period last year, for whatever dates are in context.
	measure 'Net Sales PY' = CALCULATE ( [Net Sales], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 06 Time Intelligence (context)
		lineageTag: e1fff2eb-3540-5f49-bb96-f6d86aea4286

	/// Year-over-year growth for the dates in context.
	measure 'YoY %' = IF ( NOT ISBLANK ( [Net Sales] ), DIVIDE ( [Net Sales] - [Net Sales PY], [Net Sales PY] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06 Time Intelligence (context)
		lineageTag: f3241975-471e-50ff-82ac-73e9c27a1ccf

	/// Previous month, quarter or year depending on the level shown in the visual.
	measure 'Net Sales Prior Period' =
			SWITCH (
			    TRUE (),
			    ISINSCOPE ( 'Date'[Month] ) || ISINSCOPE ( 'Date'[Month Year] ), CALCULATE ( [Net Sales], DATEADD ( 'Date'[Date], -1, MONTH ) ),
			    ISINSCOPE ( 'Date'[Quarter] ) || ISINSCOPE ( 'Date'[Year Quarter] ), CALCULATE ( [Net Sales], DATEADD ( 'Date'[Date], -1, QUARTER ) ),
			    CALCULATE ( [Net Sales], DATEADD ( 'Date'[Date], -1, YEAR ) )
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 06 Time Intelligence (context)
		lineageTag: c9345bc8-833f-544a-b264-8a9cc781608c

	/// Period-over-period growth: MoM at month level, QoQ at quarter level, YoY at year level.
	measure 'PoP %' = IF ( NOT ISBLANK ( [Net Sales] ), DIVIDE ( [Net Sales] - [Net Sales Prior Period], [Net Sales Prior Period] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 06 Time Intelligence (context)
		lineageTag: 3816d20a-1619-5921-8cd3-d88335a0a644

	/// Cumulative year-to-date net sales along a date axis (stops at the last closed month).
	measure 'Net Sales Running YTD' = IF ( MIN ( 'Date'[Date] ) <= [Last Actual Date], CALCULATE ( [Net Sales], DATESYTD ( 'Date'[Date] ) ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 06 Time Intelligence (context)
		lineageTag: 7f7961ac-dbc3-5062-b34b-7dced0720058

	/// Prior-year cumulative YTD along a date axis.
	measure 'Net Sales Running YTD PY' = CALCULATE ( CALCULATE ( [Net Sales], DATESYTD ( 'Date'[Date] ) ), SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 06 Time Intelligence (context)
		lineageTag: 59a9090b-7af6-5eaa-9e9e-1c285b2484f0

	/// Cumulative budget along a date axis (full year).
	measure 'Budget Running YTD' = CALCULATE ( [Budget Net Sales], DATESYTD ( 'Date'[Date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 06 Time Intelligence (context)
		lineageTag: aa4066a0-ed88-510a-9349-c86e3ac6e385

	/// Cumulative forecast along a date axis (full year).
	measure 'Forecast Running YTD' = CALCULATE ( [Forecast Net Sales], DATESYTD ( 'Date'[Date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 06 Time Intelligence (context)
		lineageTag: 8abf72cd-4ae9-5a08-9387-f274977d7deb

	/// Three-month moving average of net sales.
	measure 'Net Sales 3M Avg' =
			VAR _end = MAX ( 'Date'[Date] )
			RETURN
			    IF (
			        MIN ( 'Date'[Date] ) <= [Last Actual Date],
			        CALCULATE ( [Net Sales], DATESINPERIOD ( 'Date'[Date], _end, -3, MONTH ) ) / 3
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 06 Time Intelligence (context)
		lineageTag: b2c17ba8-11ed-5569-8fab-8f3f0f10adcd

	/// Latest estimate for the year: YTD actuals plus forecast for the remaining months.
	measure 'Full Year Outlook' =
			VAR _rd = [Reporting Date]
			VAR _ytd = CALCULATE ( [Net Sales], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _rd ), 1, 1 ), _rd ) )
			VAR _rest = CALCULATE ( [Forecast Net Sales], DATESBETWEEN ( 'Date'[Date], _rd + 1, DATE ( YEAR ( _rd ), 12, 31 ) ) )
			RETURN
			    IF ( NOT ISBLANK ( _rd ), _ytd + _rest )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 07 Outlook & KPIs
		lineageTag: 784f78fd-7cc0-5b5e-9e9e-f9e0b799e569

	/// Full-year budget for the reporting year.
	measure 'Full Year Budget' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Budget Net Sales], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _rd ), 1, 1 ), DATE ( YEAR ( _rd ), 12, 31 ) ) )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 07 Outlook & KPIs
		lineageTag: 05785257-13e9-5b0e-823c-16cff7a6a02d

	/// Full-year outlook minus full-year budget.
	measure 'Outlook vs Budget' = [Full Year Outlook] - [Full Year Budget]
		formatString: +\$#,0;-\$#,0;\$#,0
		displayFolder: 07 Outlook & KPIs
		lineageTag: 982de337-cd39-5e04-a4c4-eb1986834ffa

	/// Full-year outlook vs budget, %.
	measure 'Outlook vs Budget %' = DIVIDE ( [Outlook vs Budget], [Full Year Budget] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 07 Outlook & KPIs
		lineageTag: 88d115d4-47a9-5acb-99dd-945dca6156d6

	/// YTD actuals as a % of YTD budget.
	measure 'Budget Attainment % (YTD)' = DIVIDE ( [Net Sales (YTD)], [Budget Net Sales (Closed) (YTD)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Outlook & KPIs
		lineageTag: ebcdafc1-6d25-5cd7-a4c5-34d5d362db4e

	/// Share of the full-year budget already delivered.
	measure 'Full Year Budget Achieved %' = DIVIDE ( [Net Sales (YTD)], [Full Year Budget] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Outlook & KPIs
		lineageTag: 14b1b017-518b-5258-881d-b98e28359890

	/// Last three closed months x 4.
	measure 'Annualised Run Rate' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Net Sales], DATESBETWEEN ( 'Date'[Date], EOMONTH ( _rd, -3 ) + 1, _rd ) ) * 4
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 07 Outlook & KPIs
		lineageTag: e0a393ea-6d56-5b86-bd56-a619175dde39

	/// YTD net sales per active customer.
	measure 'Revenue per Customer (YTD)' = DIVIDE ( [Net Sales (YTD)], [Active Customers (YTD)] )
		formatString: \$#,0
		displayFolder: 07 Outlook & KPIs
		lineageTag: 435d41fa-8eb5-57c7-a06e-8a03fc696597

	/// Rank of the product by YTD net sales within the current selection.
	measure 'Product Rank (YTD)' = IF ( ISINSCOPE ( 'Product'[Product] ), RANKX ( ALLSELECTED ( 'Product'[Product] ), [Net Sales (YTD)], , DESC, DENSE ) )
		formatString: 0
		displayFolder: 08 Ranking & Mix
		lineageTag: f0ed5b3c-0caa-5cac-82b6-b8b7e86801a6

	/// Rank of the customer by YTD net sales within the current selection.
	measure 'Customer Rank (YTD)' = IF ( ISINSCOPE ( 'Customer'[Customer] ), RANKX ( ALLSELECTED ( 'Customer'[Customer] ), [Net Sales (YTD)], , DESC, DENSE ) )
		formatString: 0
		displayFolder: 08 Ranking & Mix
		lineageTag: 58e43293-e881-5916-99fd-780c8c38bba9

	/// Product/brand/category share of YTD net sales within the current selection.
	measure 'Share of Net Sales (YTD)' = DIVIDE ( [Net Sales (YTD)], CALCULATE ( [Net Sales (YTD)], ALLSELECTED ( 'Product' ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Ranking & Mix
		lineageTag: 04a8efe0-13ce-57a5-9842-8978c70530d1

	/// Channel share of YTD net sales.
	measure 'Channel Share (YTD)' = DIVIDE ( [Net Sales (YTD)], CALCULATE ( [Net Sales (YTD)], ALLSELECTED ( 'Channel' ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Ranking & Mix
		lineageTag: ab35474f-4469-57b4-abb8-aea6d6818c52

	/// Region share of YTD net sales.
	measure 'Region Share (YTD)' = DIVIDE ( [Net Sales (YTD)], CALCULATE ( [Net Sales (YTD)], ALLSELECTED ( 'Region' ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Ranking & Mix
		lineageTag: c96fc91d-5998-50f1-8906-3f1388a24278

	/// Static report title.
	measure 'Report Title' = "Month-End Financial Report"
		displayFolder: 09 Labels & Formatting
		lineageTag: aecec73e-629a-5b57-8b01-07201102f9cc

	/// Dynamic subtitle showing the period being reported.
	measure 'Reporting Period Label' = "Close period  ·  " & FORMAT ( [Reporting Date], "MMMM yyyy" )
		displayFolder: 09 Labels & Formatting
		lineageTag: 7d5fe355-5078-5a2c-8332-a752322f2bfd

	/// Footer label with the actuals cut-off.
	measure 'Data As Of Label' = "Actuals through " & FORMAT ( [Last Actual Date], "d MMM yyyy" ) & "  ·  USD"
		displayFolder: 09 Labels & Formatting
		lineageTag: 8ddffff7-cfd0-56fa-9ce4-325fd5998e4f

	/// Subtitle for the monthly net sales KPI tile.
	measure 'KPI Label Net Sales (Month)' =
			VAR _vf = [Var % vs Forecast (Month)]
			VAR _yoy = [YoY % (Month)]
			RETURN
			    IF ( NOT ISBLANK ( _vf ), IF ( _vf >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _vf ), "0.0%" ) & " vs Fcst    " & IF ( _yoy >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _yoy ), "0.0%" ) & " YoY" )
		displayFolder: 09 Labels & Formatting
		lineageTag: abd94f50-8c15-5459-ba61-489639a8ceb3

	/// Subtitle for the gross margin % KPI tile.
	measure 'KPI Label Gross Margin % (Month)' =
			VAR _vb = [GM % pts vs Budget (Month)]
			VAR _py = [GM % pts vs PY (Month)]
			RETURN
			    IF ( NOT ISBLANK ( _vb ), IF ( _vb * 100 >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _vb * 100 ), "0.0" ) & " pp vs Bud    " & IF ( _py * 100 >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _py * 100 ), "0.0" ) & " pp YoY" )
		displayFolder: 09 Labels & Formatting
		lineageTag: e4a378df-dce5-5131-8b3b-4a11159a5e45

	/// Subtitle for the YTD net sales KPI tile.
	measure 'KPI Label Net Sales (YTD)' =
			VAR _yoy = [YoY % (YTD)]
			VAR _att = [Budget Attainment % (YTD)]
			RETURN
			    IF ( NOT ISBLANK ( _yoy ), IF ( _yoy >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _yoy ), "0.0%" ) & " YoY    " & FORMAT ( _att, "0.0%" ) & " of budget" )
		displayFolder: 09 Labels & Formatting
		lineageTag: 477b1ba0-c714-5203-91a0-19362364a1b3

	/// Subtitle for the full-year outlook KPI tile.
	measure 'KPI Label Outlook' =
			VAR _v = [Outlook vs Budget %]
			RETURN
			    IF ( NOT ISBLANK ( _v ), IF ( _v >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _v ), "0.0%" ) & " vs FY budget  (" & FORMAT ( [Full Year Budget], "$#,0.0,,") & "M)" )
		displayFolder: 09 Labels & Formatting
		lineageTag: 98f44724-9dae-5218-b9aa-4c4031c39aeb

	/// Subtitle for the forecast accuracy KPI tile.
	measure 'KPI Label Accuracy (Month)' =
			VAR _a = [Forecast Accuracy % (Month)]
			VAR _b = [Forecast Bias % (Month)]
			RETURN
			    IF ( NOT ISBLANK ( _a ), "Target " & FORMAT ( [Forecast Accuracy Target], "0%" ) & "    Bias " & FORMAT ( _b, "+0.0%;-0.0%" ) )
		displayFolder: 09 Labels & Formatting
		lineageTag: d8af2009-2a58-5f06-a25e-a9e2292a7f87

	/// Subtitle for the monthly forecast variance tile.
	measure 'KPI Label Var vs Forecast (Month)' =
			VAR _v = [Var % vs Forecast (Month)]
			RETURN
			    IF ( NOT ISBLANK ( _v ), IF ( _v >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _v ), "0.0%" ) & " of forecast  ·  " & FORMAT ( [Forecast Net Sales (Closed) (Month)], "$#,0.00,,") & "M fcst" )
		displayFolder: 09 Labels & Formatting
		lineageTag: b37cc63a-2487-57d9-b501-9b9e87d894f0

	/// Subtitle for the YTD budget variance tile.
	measure 'KPI Label Var vs Budget (YTD)' =
			VAR _v = [Var % vs Budget (YTD)]
			RETURN
			    IF ( NOT ISBLANK ( _v ), IF ( _v >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _v ), "0.0%" ) & " of budget  ·  " & FORMAT ( [Budget Net Sales (Closed) (YTD)], "$#,0.0,,") & "M bud" )
		displayFolder: 09 Labels & Formatting
		lineageTag: 973cee0b-e8e5-5422-b3f3-e04b75f41654

	/// Subtitle for the YTD forecast accuracy tile.
	measure 'KPI Label Accuracy (YTD)' =
			VAR _a = [Forecast Accuracy % (YTD)]
			RETURN
			    IF ( NOT ISBLANK ( _a ), "MAPE (SKU) " & FORMAT ( CALCULATE ( [MAPE %], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( [Reporting Date] ), 1, 1 ), [Reporting Date] ) ), "0.0%" ) & "    Target " & FORMAT ( [Forecast Accuracy Target], "0%" ) )
		displayFolder: 09 Labels & Formatting
		lineageTag: 498025a3-ce7a-58c9-a35c-caff962b9284

	/// Subtitle for the forecast bias tile.
	measure 'KPI Label Bias (YTD)' =
			VAR _b = [Forecast Bias % (YTD)]
			RETURN
			    IF ( NOT ISBLANK ( _b ), IF ( _b > 0.005, "Over-forecasting", IF ( _b < -0.005, "Under-forecasting", "Unbiased" ) ) & "  ·  ±0.5% tolerance" )
		displayFolder: 09 Labels & Formatting
		lineageTag: 667427ee-ad69-53bc-ada5-978e1cb82269

	/// Subtitle for the QTD tile.
	measure 'KPI Label QTD' =
			VAR _q = [QoQ %]
			VAR _y = [YoY % (QTD)]
			RETURN
			    IF ( NOT ISBLANK ( _q ), IF ( _q >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _q ), "0.0%" ) & " QoQ    " & IF ( _y >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _y ), "0.0%" ) & " YoY" )
		displayFolder: 09 Labels & Formatting
		lineageTag: 1fb70353-4103-5004-b0bd-2025b9518c3c

	/// Subtitle for the YTD vs PY tile.
	measure 'KPI Label YTD YoY' =
			VAR _y = [YoY % (YTD)]
			RETURN
			    IF ( NOT ISBLANK ( _y ), IF ( _y >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _y ), "0.0%" ) & " vs PY  (" & FORMAT ( [YoY Change (YTD)], "+$#,0.0,,;-$#,0.0,,") & "M)" )
		displayFolder: 09 Labels & Formatting
		lineageTag: 4865ab28-b3db-5ebb-8c51-21499306a516

	/// Subtitle for the rolling 12M tile.
	measure 'KPI Label R12M' =
			VAR _y = [YoY % (R12M)]
			RETURN
			    IF ( NOT ISBLANK ( _y ), IF ( _y >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _y ), "0.0%" ) & " vs prior 12M  ·  run rate " & FORMAT ( [Annualised Run Rate], "$#,0.0,,") & "M" )
		displayFolder: 09 Labels & Formatting
		lineageTag: b1bfbbae-70c7-52c5-bc49-b73ddeb6057a

	/// Subtitle for the YTD gross margin % tile.
	measure 'KPI Label GM % (YTD)' =
			VAR _p = [GM % pts vs PY (YTD)]
			RETURN
			    IF ( NOT ISBLANK ( _p ), IF ( _p * 100 >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _p * 100 ), "0.0" ) & " pp vs PY  ·  GM " & FORMAT ( [Gross Margin (YTD)], "$#,0.0,,") & "M" )
		displayFolder: 09 Labels & Formatting
		lineageTag: be7558c4-63f6-526b-9723-8abdbafbedd6

	/// Subtitle for the YTD discount % tile.
	measure 'KPI Label Discount % (YTD)' =
			VAR _p = [Discount % pts vs PY (YTD)]
			RETURN
			    IF ( NOT ISBLANK ( _p ), IF ( _p * 100 >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _p * 100 ), "0.0" ) & " pp vs PY  ·  " & FORMAT ( [Discounts], "$#,0.0,,") & "M all-time" )
		displayFolder: 09 Labels & Formatting
		lineageTag: 59369426-3743-5a35-9b8e-c365340ab9e8

	/// Hex colour for conditional formatting driven by [Var % vs Forecast]: green favourable, red unfavourable, grey within ±0.5%.
	measure 'Color Var % vs Forecast' =
			VAR _v = [Var % vs Forecast]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _v ), "#898781",
			        _v >= 0.005, "#006300",
			        _v <= -0.005, "#D03B3B",
			        "#52514E"
			    )
		displayFolder: 09 Labels & Formatting
		lineageTag: f060ea4e-721d-52ff-aa5e-5ac06a76c107

	/// Hex colour for conditional formatting driven by [Var % vs Budget]: green favourable, red unfavourable, grey within ±0.5%.
	measure 'Color Var % vs Budget' =
			VAR _v = [Var % vs Budget]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _v ), "#898781",
			        _v >= 0.005, "#006300",
			        _v <= -0.005, "#D03B3B",
			        "#52514E"
			    )
		displayFolder: 09 Labels & Formatting
		lineageTag: 6744dce0-ad48-54d4-af63-4e51a76cd34f

