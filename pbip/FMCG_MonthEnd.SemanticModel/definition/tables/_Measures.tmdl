table _Measures
	lineageTag: 0eb74608-9f04-50ff-8ba6-a2f6eb8d8cd0

	/// Invoice value at list price, before trade discounts.
	measure 'Gross Sales' = SUM ( 'Fact Sales'[GrossSales] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 01 Actuals
		lineageTag: 5256d5ef-dfa3-555f-a5ed-b0b9454d84c3

	/// Trade and promotional discounts.
	measure Discounts = SUM ( 'Fact Sales'[DiscountAmount] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 01 Actuals
		lineageTag: e1cc1ca8-d047-5b24-b4bd-d7de9976ffce

	/// Gross sales less discounts. The headline revenue measure.
	measure 'Net Sales' = SUM ( 'Fact Sales'[NetSales] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 01 Actuals
		lineageTag: ec764498-2da1-5f20-a0f5-37230a3cde23

	/// Cost of goods sold at standard cost.
	measure COGS = SUM ( 'Fact Sales'[COGS] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 01 Actuals
		lineageTag: cdedf455-20c4-5881-bb08-ea38563ee4fa

	/// Net sales less COGS.
	measure 'Gross Margin' = [Net Sales] - [COGS]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 01 Actuals
		lineageTag: e8c2c531-affa-571f-9fd3-afa276d6a497

	/// Gross margin as a share of net sales.
	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Actuals
		lineageTag: d2f22166-a848-5657-acc3-3119577335f7

	/// Units invoiced.
	measure 'Units Sold' = SUM ( 'Fact Sales'[Units] )
		formatString: #,0
		displayFolder: 01 Actuals
		lineageTag: a53a4558-9c4b-5a65-8062-c4b43165e3b2

	/// Discounts as a share of gross sales.
	measure 'Discount %' = DIVIDE ( [Discounts], [Gross Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Actuals
		lineageTag: cc715d58-c0c6-5d9a-b313-d0642cb76072

	/// Net sales per unit.
	measure 'Avg Net Price' = DIVIDE ( [Net Sales], [Units Sold] )
		formatString: \$#,0.00
		displayFolder: 01 Actuals
		lineageTag: c68f5666-a772-50a2-8398-14ff2ada22b9

	/// Number of distinct sales orders.
	measure Orders = DISTINCTCOUNT ( 'Fact Sales'[OrderNumber] )
		formatString: #,0
		displayFolder: 01 Actuals
		lineageTag: 2309ba25-af1f-5074-b3d1-5bf9582c95b6

	/// Net sales per order.
	measure 'Avg Order Value' = DIVIDE ( [Net Sales], [Orders] )
		formatString: \$#,0
		displayFolder: 01 Actuals
		lineageTag: 811567e8-b76c-552e-849d-e4872ea62a5a

	/// Customers with at least one invoice in context.
	measure 'Active Customers' = DISTINCTCOUNT ( 'Fact Sales'[CustomerKey] )
		formatString: #,0
		displayFolder: 01 Actuals
		lineageTag: d9bd7e99-1b6c-5b45-b801-1d0012e3b308

	/// SKUs with at least one invoice in context.
	measure 'Active SKUs' = DISTINCTCOUNT ( 'Fact Sales'[ProductKey] )
		formatString: #,0
		displayFolder: 01 Actuals
		lineageTag: f87fc3d5-7a7e-5ddd-bfaa-26794b566a65

	/// Latest rolling forecast of net sales (all periods, including future months).
	measure 'Forecast Net Sales' = SUM ( 'Fact Forecast'[ForecastNetSales] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 02 Forecast & Budget
		lineageTag: eb9d698f-9f01-5eb4-9907-01157c996b31

	/// Latest rolling forecast of units.
	measure 'Forecast Units' = SUM ( 'Fact Forecast'[ForecastUnits] )
		formatString: #,0
		displayFolder: 02 Forecast & Budget
		lineageTag: ad437760-3cf8-5c2d-a8a3-d8ec69dba5c3

	/// Forecast cost of goods sold.
	measure 'Forecast COGS' = SUM ( 'Fact Forecast'[ForecastCOGS] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 02 Forecast & Budget
		lineageTag: f9a82b47-4145-58bc-9952-4273e39a577d

	/// Forecast net sales less forecast COGS.
	measure 'Forecast Gross Margin' = [Forecast Net Sales] - [Forecast COGS]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 02 Forecast & Budget
		lineageTag: 571169cd-c817-5a12-863e-7e18a5532807

	/// Forecast gross margin %.
	measure 'Forecast Gross Margin %' = DIVIDE ( [Forecast Gross Margin], [Forecast Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Forecast & Budget
		lineageTag: 3a76341d-0951-589a-a7bc-c911a64a123a

	/// Annual operating plan (budget) net sales.
	measure 'Budget Net Sales' = SUM ( 'Fact Forecast'[BudgetNetSales] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 02 Forecast & Budget
		lineageTag: 985644a7-0926-5104-9b0c-a0972606119d

	/// Budget units.
	measure 'Budget Units' = SUM ( 'Fact Forecast'[BudgetUnits] )
		formatString: #,0
		displayFolder: 02 Forecast & Budget
		lineageTag: 24a5142b-c491-5688-a702-b8c27e028ec2

	/// Budget cost of goods sold.
	measure 'Budget COGS' = SUM ( 'Fact Forecast'[BudgetCOGS] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 02 Forecast & Budget
		lineageTag: 76fb3974-c977-5390-9b39-ef418e0fb102

	/// Budget net sales less budget COGS.
	measure 'Budget Gross Margin' = [Budget Net Sales] - [Budget COGS]
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 02 Forecast & Budget
		lineageTag: d95e574c-4cf0-5b45-b5c1-57ba576d81e5

	/// Budget gross margin %.
	measure 'Budget Gross Margin %' = DIVIDE ( [Budget Gross Margin], [Budget Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Forecast & Budget
		lineageTag: 4199581a-1def-5f74-be43-d719ae18561f

	/// Forecast Net Sales restricted to closed periods, so it is like-for-like with actuals (future months are excluded).
	measure 'Forecast Net Sales (Closed)' = CALCULATE ( [Forecast Net Sales], KEEPFILTERS ( 'Date'[Is Actual Period] = TRUE () ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 02 Forecast & Budget
		lineageTag: 76d26940-1fbc-5775-a1a9-834745b7734c

	/// Forecast Units restricted to closed periods, so it is like-for-like with actuals (future months are excluded).
	measure 'Forecast Units (Closed)' = CALCULATE ( [Forecast Units], KEEPFILTERS ( 'Date'[Is Actual Period] = TRUE () ) )
		formatString: #,0
		displayFolder: 02 Forecast & Budget
		lineageTag: 50394649-8027-5143-a4a3-9ce132df4053

	/// Forecast Gross Margin restricted to closed periods, so it is like-for-like with actuals (future months are excluded).
	measure 'Forecast Gross Margin (Closed)' = CALCULATE ( [Forecast Gross Margin], KEEPFILTERS ( 'Date'[Is Actual Period] = TRUE () ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 02 Forecast & Budget
		lineageTag: 37e33840-c165-5a0c-83fe-ecaec23a1e10

	/// Budget Net Sales restricted to closed periods, so it is like-for-like with actuals (future months are excluded).
	measure 'Budget Net Sales (Closed)' = CALCULATE ( [Budget Net Sales], KEEPFILTERS ( 'Date'[Is Actual Period] = TRUE () ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 02 Forecast & Budget
		lineageTag: ffda1bac-7067-5a26-a3b7-11a6388cf7a4

	/// Budget Units restricted to closed periods, so it is like-for-like with actuals (future months are excluded).
	measure 'Budget Units (Closed)' = CALCULATE ( [Budget Units], KEEPFILTERS ( 'Date'[Is Actual Period] = TRUE () ) )
		formatString: #,0
		displayFolder: 02 Forecast & Budget
		lineageTag: 97da0c81-30d8-5bba-bb2d-88801c1a6e42

	/// Budget Gross Margin restricted to closed periods, so it is like-for-like with actuals (future months are excluded).
	measure 'Budget Gross Margin (Closed)' = CALCULATE ( [Budget Gross Margin], KEEPFILTERS ( 'Date'[Is Actual Period] = TRUE () ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 02 Forecast & Budget
		lineageTag: c0c10cdb-888d-54a1-8c70-45c3c8176db3

	/// Budget GM % for closed periods.
	measure 'Budget Gross Margin % (Closed)' = DIVIDE ( [Budget Gross Margin (Closed)], [Budget Net Sales (Closed)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 02 Forecast & Budget
		lineageTag: e234aa8e-bb14-5baa-9cd8-cfbcf97cd773

	/// Actual net sales minus forecast (closed periods). Positive = favourable.
	measure 'Var vs Forecast' =
			VAR _act = [Net Sales]
			VAR _fc = [Forecast Net Sales (Closed)]
			RETURN
			    IF ( NOT ISBLANK ( _act ) || NOT ISBLANK ( _fc ), _act - _fc )
		formatString: +\$#,0;-\$#,0;\$#,0
		displayFolder: 03 Variance
		lineageTag: b1c432c3-0036-58b6-952a-b781a7f83057

	/// Variance to forecast as a % of forecast.
	measure 'Var % vs Forecast' = DIVIDE ( [Var vs Forecast], [Forecast Net Sales (Closed)] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Variance
		lineageTag: 8e661a8d-fa59-5747-afd2-5fae6c208a66

	/// Actual net sales minus budget (closed periods). Positive = favourable.
	measure 'Var vs Budget' =
			VAR _act = [Net Sales]
			VAR _bud = [Budget Net Sales (Closed)]
			RETURN
			    IF ( NOT ISBLANK ( _act ) || NOT ISBLANK ( _bud ), _act - _bud )
		formatString: +\$#,0;-\$#,0;\$#,0
		displayFolder: 03 Variance
		lineageTag: 81c22842-221d-5b25-a87c-ccf15b70c9a6

	/// Variance to budget as a % of budget.
	measure 'Var % vs Budget' = DIVIDE ( [Var vs Budget], [Budget Net Sales (Closed)] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Variance
		lineageTag: 1876e9cd-a069-5774-817b-ca965caf1a8d

	/// Units sold minus forecast units.
	measure 'Units Var vs Forecast' = IF ( NOT ISBLANK ( [Units Sold] ), [Units Sold] - [Forecast Units (Closed)] )
		formatString: +#,0;-#,0;0
		displayFolder: 03 Variance
		lineageTag: 1fd288a3-addd-5fac-8aed-76a6c764d0a0

	/// Unit variance to forecast as a %.
	measure 'Units Var % vs Forecast' = DIVIDE ( [Units Var vs Forecast], [Forecast Units (Closed)] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Variance
		lineageTag: 46c7df7f-c78c-5abb-bf7b-1d94e98c3e41

	/// Gross margin minus budget gross margin.
	measure 'GM Var vs Budget' = IF ( NOT ISBLANK ( [Net Sales] ), [Gross Margin] - [Budget Gross Margin (Closed)] )
		formatString: +\$#,0;-\$#,0;\$#,0
		displayFolder: 03 Variance
		lineageTag: 62813e92-5a59-5761-971f-53136bb3e13e

	/// Gross margin % minus budget GM % (percentage points).
	measure 'GM % pts vs Budget' = IF ( NOT ISBLANK ( [Net Sales] ), [Gross Margin %] - [Budget Gross Margin % (Closed)] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 03 Variance
		lineageTag: bb7b4a89-05a8-563f-bf12-08cbffa9d601

	/// Part of the budget variance explained by units (SKU x month grain): (actual units - budget units) x budget price. Includes SKU mix.
	measure 'Volume & Mix Effect vs Budget' =
			VAR _grid =
			    ADDCOLUMNS (
			        CROSSJOIN (
			            CALCULATETABLE ( VALUES ( 'Date'[Year Month Key] ), 'Date'[Is Actual Period] = TRUE () ),
			            VALUES ( 'Product'[ProductKey] )
			        ),
			        "@ua", [Units Sold],
			        "@na", [Net Sales],
			        "@ub", [Budget Units],
			        "@nb", [Budget Net Sales]
			    )
			RETURN
			    SUMX (
			        _grid,
			        IF ( [@ub] = 0, [@na] - [@nb], ( [@ua] - [@ub] ) * DIVIDE ( [@nb], [@ub] ) )
			    )
		formatString: +\$#,0;-\$#,0;\$#,0
		displayFolder: 03 Variance
		lineageTag: e1c418db-1605-5b3d-a156-628e019a18e5

	/// Part of the budget variance explained by realised net price (list price changes and discount depth). Volume + Price = total variance.
	measure 'Price & Discount Effect vs Budget' = [Var vs Budget] - [Volume & Mix Effect vs Budget]
		formatString: +\$#,0;-\$#,0;\$#,0
		displayFolder: 03 Variance
		lineageTag: 801a2ed3-3eb5-5359-a212-f7ccb7c4642b

	/// Feeds the Budget -> Actual waterfall. The waterfall total equals actual net sales.
	measure 'Bridge Value' =
			SWITCH (
			    SELECTEDVALUE ( 'Variance Bridge'[Step] ),
			    "Budget", [Budget Net Sales (Closed)],
			    "Volume & Mix", [Volume & Mix Effect vs Budget],
			    "Price & Discount", [Price & Discount Effect vs Budget]
			)
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 03 Variance
		lineageTag: 2de7bbe2-dfa9-5018-bb30-72994f182f43

	/// Target forecast accuracy (1 - WMAPE).
	measure 'Forecast Accuracy Target' = 0.90
		formatString: 0%
		displayFolder: 04 Forecast Accuracy
		lineageTag: 2af28ad5-72a7-544f-afb1-176d93a67d23

	/// Sum of absolute forecast errors at SKU x Region x Month grain (errors don't cancel out across SKUs).
	measure 'Forecast Abs Error' =
			VAR _grid =
			    CROSSJOIN (
			        CALCULATETABLE ( VALUES ( 'Date'[Year Month Key] ), 'Date'[Is Actual Period] = TRUE () ),
			        VALUES ( 'Product'[ProductKey] ),
			        VALUES ( 'Region'[RegionKey] )
			    )
			RETURN
			    SUMX ( _grid, ABS ( [Net Sales] - [Forecast Net Sales] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 04 Forecast Accuracy
		lineageTag: 7e10c8ea-e55b-5d1e-828f-66f0f58f3f7f

	/// Weighted mean absolute percentage error = sum |actual - forecast| / sum actual.
	measure 'WMAPE %' = DIVIDE ( [Forecast Abs Error], [Net Sales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Forecast Accuracy
		lineageTag: 53f2b29e-8b1e-502e-83fb-d5a763069959

	/// 1 - WMAPE, floored at 0. The standard demand-planning accuracy KPI.
	measure 'Forecast Accuracy %' = IF ( NOT ISBLANK ( [Net Sales] ), MAX ( 0, 1 - [WMAPE %] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Forecast Accuracy
		lineageTag: a7c4cd8e-7c01-515e-8d91-d6885e793538

	/// Unweighted mean absolute percentage error across SKU x Month cells (every SKU counts equally).
	measure 'MAPE %' =
			VAR _grid =
			    ADDCOLUMNS (
			        CROSSJOIN (
			            CALCULATETABLE ( VALUES ( 'Date'[Year Month Key] ), 'Date'[Is Actual Period] = TRUE () ),
			            VALUES ( 'Product'[ProductKey] )
			        ),
			        "@a", [Net Sales],
			        "@f", [Forecast Net Sales]
			    )
			RETURN
			    AVERAGEX ( FILTER ( _grid, [@a] > 0 ), ABS ( [@a] - [@f] ) / [@a] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 04 Forecast Accuracy
		lineageTag: 6dbb6782-b4c7-5d39-84a4-d8abc17611b2

	/// Positive = over-forecasting, negative = under-forecasting.
	measure 'Forecast Bias %' = DIVIDE ( [Forecast Net Sales (Closed)] - [Net Sales], [Net Sales] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Forecast Accuracy
		lineageTag: 62f5cf22-8d23-5fa5-940c-4cf081775422

	/// Forecast accuracy minus target, in percentage points.
	measure 'Accuracy vs Target (pts)' = IF ( NOT ISBLANK ( [Forecast Accuracy %] ), [Forecast Accuracy %] - [Forecast Accuracy Target] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 04 Forecast Accuracy
		lineageTag: e81079cc-ed45-5761-bf49-7a97c3bb3d46

	/// Month-end of the latest month with actuals, regardless of filters.
	measure 'Last Actual Date' = EOMONTH ( CALCULATE ( MAX ( 'Fact Sales'[OrderDate] ), REMOVEFILTERS () ), 0 )
		formatString: dd mmm yyyy
		displayFolder: 05 Reporting Period
		lineageTag: 5a65de50-8e5b-589e-99aa-c1e50ab4ea49

	/// The as-of date for every (Month)/(QTD)/(YTD) measure: the end of the selected period, capped at the last closed month. With no date selection it is the last closed month.
	measure 'Reporting Date' =
			VAR _last = [Last Actual Date]
			VAR _minCtx = MIN ( 'Date'[Date] )
			VAR _maxCtx = MAX ( 'Date'[Date] )
			RETURN
			    IF ( _minCtx <= _last, MIN ( _maxCtx, _last ) )
		formatString: dd mmm yyyy
		displayFolder: 05 Reporting Period
		lineageTag: cee7ceb4-4df8-5da4-8169-acb002edbb70

	/// [Net Sales] for the reporting month.
	measure 'Net Sales (Month)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Net Sales], DATESBETWEEN ( 'Date'[Date], EOMONTH ( _rd, -1 ) + 1, _rd ) )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: ef43c0ff-19f6-5a49-87db-9b85a5edab41

	/// [Net Sales] for the month before the reporting month.
	measure 'Net Sales (Prior Month)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Net Sales], DATESBETWEEN ( 'Date'[Date], EOMONTH ( _rd, -2 ) + 1, EOMONTH ( _rd, -1 ) ) )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: 6ba63185-4490-5a76-94be-e2c97364ebe0

	/// [Net Sales] for the same month last year.
	measure 'Net Sales (PY Month)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Net Sales], DATESBETWEEN ( 'Date'[Date], EOMONTH ( _rd, -13 ) + 1, EOMONTH ( _rd, -12 ) ) )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: 6da944bd-2d24-501d-9495-fe6d66ed2e98

	/// [Net Sales] for quarter-to-date through the reporting month.
	measure 'Net Sales (QTD)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Net Sales], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _rd ), QUARTER ( _rd ) * 3 - 2, 1 ), _rd ) )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: 634f9a96-7349-5a71-8c89-3cfe0046921f

	/// [Net Sales] for the equivalent quarter-to-date one quarter earlier.
	measure 'Net Sales (Prior QTD)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Net Sales], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( EOMONTH ( _rd, -3 ) ), QUARTER ( EOMONTH ( _rd, -3 ) ) * 3 - 2, 1 ), EOMONTH ( _rd, -3 ) ) )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: 580ee8b4-8d85-5539-853b-726a30ef987f

	/// [Net Sales] for the same quarter-to-date last year.
	measure 'Net Sales (PY QTD)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Net Sales], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _rd ) - 1, QUARTER ( _rd ) * 3 - 2, 1 ), EOMONTH ( _rd, -12 ) ) )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: fd4659a1-5358-50a7-93a8-7fa8e04ed082

	/// [Net Sales] for year-to-date through the reporting month.
	measure 'Net Sales (YTD)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Net Sales], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _rd ), 1, 1 ), _rd ) )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: 917bb031-c145-5eb0-ba9c-3b2ae34427d0

	/// [Net Sales] for the same year-to-date period last year.
	measure 'Net Sales (PY YTD)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Net Sales], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _rd ) - 1, 1, 1 ), EOMONTH ( _rd, -12 ) ) )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: e9d3d40a-aac2-5bf6-9336-6d319d571287

	/// [Net Sales] for the rolling 12 months ending with the reporting month.
	measure 'Net Sales (R12M)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Net Sales], DATESBETWEEN ( 'Date'[Date], EOMONTH ( _rd, -12 ) + 1, _rd ) )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: 01b56e45-e65e-5ffd-8dd6-ceb554c6f48d

	/// [Net Sales] for the rolling 12 months one year earlier.
	measure 'Net Sales (PY R12M)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Net Sales], DATESBETWEEN ( 'Date'[Date], EOMONTH ( _rd, -24 ) + 1, EOMONTH ( _rd, -12 ) ) )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: 340a2a49-be27-5c23-b070-9f155c3b7c48

	/// [Gross Margin] for the reporting month.
	measure 'Gross Margin (Month)' =
			VAR _rd = [Reporting Date]
			RETURN
			    IF (
			        NOT ISBLANK ( _rd ),
			        CALCULATE ( [Gross Margin], DATESBETWEEN ( 'Date'[Date], EOMONTH ( _rd, -1 ) + 1, _rd ) )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 05 Reporting Period
		lineageTag: 5937d4d0-6560-5b82-8c83-50174af76044

	/// [Gross Margin %] for the reporting month.
	measure 'Gross Margin % (Month)' =
			VAR _rd = [Reporting Date]
			RETURN
