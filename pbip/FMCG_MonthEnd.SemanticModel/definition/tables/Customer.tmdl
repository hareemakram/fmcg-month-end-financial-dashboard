table Customer
	lineageTag: d8518086-cf99-5d24-83f0-f28eba1be814

	column CustomerKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 34b10103-4a33-532a-8c12-20edea03a01e
		summarizeBy: none
		sourceColumn: CustomerKey

		annotation SummarizationSetBy = Automatic

	column 'Customer Code'
		dataType: string
		lineageTag: 5f8eef70-2ed7-5ee7-89ec-dbc58868cda1
		summarizeBy: none
		sourceColumn: Customer Code

		annotation SummarizationSetBy = Automatic

	column Customer
		dataType: string
		lineageTag: 905dfd46-6dfb-5607-9d52-4e96c99e1166
		summarizeBy: none
		sourceColumn: Customer

