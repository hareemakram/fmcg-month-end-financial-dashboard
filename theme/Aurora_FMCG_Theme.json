{
  "name": "Aurora FMCG Finance",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#008300",
    "#6250D6",
    "#E34948"
  ],
  "foreground": "#0B0B0B",
  "foregroundNeutralSecondary": "#52514E",
  "foregroundNeutralTertiary": "#898781",
  "background": "#FFFFFF",
  "backgroundLight": "#F9F9F7",
  "backgroundNeutral": "#E1E0D9",
  "tableAccent": "#2A78D6",
  "hyperlink": "#2A78D6",
  "visitedHyperlink": "#6250D6",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "maximum": "#104281",
  "center": "#F0EFEC",
  "minimum": "#D03B3B",
  "null": "#C3C2B7",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#52514E"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E6E5DF"
              }
            },
            "radius": 10,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "position": "Outer",
            "preset": "Custom",
            "shadowSpread": 0,
            "shadowBlur": 12,
            "angle": 90,
            "shadowDistance": 2,
            "transparency": 93
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 14,
            "right": 14
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#898781"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "foreground": {
              "solid": {
                "color": "#898781"
              }
            },
            "transparency": 100
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#898781"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#ECEBE6"
              }
            },
            "gridlineThickness": 1,
            "gridlineStyle": "solid",
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#898781"
              }
            },
            "fontSize": 9,
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "labelColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontSize": 9,
            "showTitle": false
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F3EF"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F3EF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontSize": 24,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontSize": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 4,
            "bottom": 4,
            "left": 8,
            "right": 8
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F4F3EF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9,
            "wordWrap": true
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontSize": 9,
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FAFAF8"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "backColor": {
              "solid": {
                "color": "#F4F3EF"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#ECEBE6"
              }
            },
            "gridVertical": false,
            "rowPadding": 4
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#52514E"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F4F3EF"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontSize": 9,
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FAFAF8"
              }
            }
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B0B0B"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "backColor": {
              "solid": {
                "color": "#F4F3EF"
              }
            }
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#ECEBE6"
              }
            },
            "gridVertical": false,
            "rowPadding": 4
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "waterfallChart": {
      "*": {
        "sentimentColors": [
          {
            "increaseFill": {
              "solid": {
                "color": "#0CA30C"
              }
            },
            "decreaseFill": {
              "solid": {
                "color": "#D03B3B"
              }
            },
            "totalFill": {
              "solid": {
                "color": "#2A78D6"
              }
            }
          }
        ]
      }
    }
  }
}